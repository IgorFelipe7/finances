VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI is NOT configured here anymore — the key lives only as a Supabase Edge Function
# secret (never in the browser bundle). See supabase/functions/openai-proxy and the
# "AI setup" section in README.md for the one-time deploy steps.

# Public half of the VAPID keypair used for Web Push (safe to expose client-side — it's
# the private half that must stay a server-only secret). See "Push notifications" in
# README.md — without this, the notification toggle in Settings just stays disabled.
VITE_VAPID_PUBLIC_KEY=
